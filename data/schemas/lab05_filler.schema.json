{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Lab 05/06 shared filler/distractor sentence pool",
  "type": "object",
  "required": ["dataset_version", "language", "filler_sentences", "generic_near_miss_noise"],
  "additionalProperties": false,
  "properties": {
    "dataset_version": { "type": "string", "minLength": 1 },
    "language": { "const": "tr" },
    "filler_sentences": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "generic_near_miss_noise": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
