{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Lab 04 policy document corpus",
  "type": "object",
  "required": ["dataset_version", "language", "documents"],
  "additionalProperties": false,
  "properties": {
    "dataset_version": { "type": "string", "minLength": 1 },
    "language": { "const": "tr" },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["doc_id", "text", "effective_date", "superseded_by", "tags"],
        "additionalProperties": false,
        "properties": {
          "doc_id": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 },
          "effective_date": { "type": "string" },
          "superseded_by": { "oneOf": [{ "type": "null" }, { "type": "string" }] },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
