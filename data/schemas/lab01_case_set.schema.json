{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Lab 01 customer-message case set (eval or example_pool)",
  "type": "object",
  "required": ["dataset_version", "language", "labels", "cases"],
  "additionalProperties": false,
  "properties": {
    "dataset_version": { "type": "string", "minLength": 1 },
    "language": { "const": "tr" },
    "labels": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "uniqueItems": true
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["case_id", "text", "label", "priority", "metadata"],
        "additionalProperties": false,
        "properties": {
          "case_id": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 },
          "label": { "type": "string" },
          "priority": { "enum": ["low", "medium", "high"] },
          "metadata": {
            "type": "object",
            "required": ["difficulty", "tags", "source", "language"],
            "additionalProperties": false,
            "properties": {
              "difficulty": { "type": "string" },
              "tags": { "type": "array", "items": { "type": "string" } },
              "source": { "const": "synthetic" },
              "language": { "const": "tr" }
            }
          }
        }
      }
    }
  }
}
