{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Lab 05 target facts",
  "type": "object",
  "required": ["dataset_version", "language", "facts"],
  "additionalProperties": false,
  "properties": {
    "dataset_version": { "type": "string", "minLength": 1 },
    "language": { "const": "tr" },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "fact_id", "fact_type", "fact_sentence", "near_miss_sentence", "question",
          "gold_answer", "near_miss_answer"
        ],
        "additionalProperties": false,
        "properties": {
          "fact_id": { "type": "string", "minLength": 1 },
          "fact_type": { "type": "string" },
          "fact_sentence": { "type": "string", "minLength": 1 },
          "near_miss_sentence": { "type": "string", "minLength": 1 },
          "question": { "type": "string", "minLength": 1 },
          "gold_answer": { "type": "string", "minLength": 1 },
          "near_miss_answer": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
